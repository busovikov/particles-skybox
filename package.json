{
  "name": "particles-skybox",
  "version": "0.1.0",
  "description": "GPU attractor particles rendered into a living skybox for Three.js worlds.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/particles-skybox.js",
  "module": "./dist/particles-skybox.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/particles-skybox.js"
    },
    "./preset": "./src/current-preset.json"
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "src/current-preset.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --config vite.library.config.js",
    "build:demo": "vite build",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "three": "0.180.0",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
